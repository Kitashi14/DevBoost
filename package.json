{
  "name": "devboostextension",
  "displayName": "DevBoost",
  "description": "Boost your productivity through AI-driven tools.",
  "version": "0.9.3",
  "publisher": "DevBoost",
  "icon": "images/devboost.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kitashi14/DevBoost"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "ai",
    "productivity",
    "automation",
    "terminal",
    "command",
    "prompt",
    "github copilot",
    "copilot",
    "ollama",
    "anthropic",
    "openai",
    "gemini"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devboost-sidebar",
          "title": "DevBoost",
          "icon": "$(rocket)"
        }
      ]
    },
    "views": {
      "devboost-sidebar": [
        {
          "id": "devboost.smartCmdView",
          "name": "SmartCmd",
          "icon": "$(terminal)"
        },
        {
          "id": "devboost.promptEnhancerView",
          "name": "Prompt Enhancer",
          "icon": "$(sparkle)"
        }
      ]
    },
    "commands": [
      {
        "command": "DevBoost.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "devboost.smartCmdCreateButtons",
        "title": "Create AI Suggested Buttons for this workspace",
        "icon": "$(sparkle)"
      },
      {
        "command": "devboost.smartCmdCreateCustomButton",
        "title": "Create Custom Button",
        "icon": "$(add)"
      },
      {
        "command": "devboost.executeButton",
        "title": "Execute Button",
        "icon": "$(play)"
      },
      {
        "command": "devboost.deleteButton",
        "title": "Delete Button",
        "icon": "$(trash)"
      },
      {
        "command": "devboost.editButton",
        "title": "View/Edit Button Details",
        "icon": "$(edit)"
      },
      {
        "command": "devboost.refreshButtons",
        "title": "Refresh Buttons",
        "icon": "$(refresh)"
      },
      {
        "command": "devboost.openButtonsFile",
        "title": "Open Buttons File",
        "icon": "$(file-code)"
      },
      {
        "command": "devboost.addToGlobal",
        "title": "Add to Global Buttons",
        "icon": "$(globe)"
      },
      {
        "command": "devboost.showPromptEnhancer",
        "title": "Show Prompt Enhancer",
        "icon": "$(sparkle)"
      },
      {
        "command": "devboost.quickEnhance",
        "title": "Quick Enhance from Clipboard",
        "icon": "$(zap)"
      },
      {
        "command": "devboost.enhancePromptFromInput",
        "title": "Enhance Prompt from Input",
        "icon": "$(sparkle)"
      },
      {
        "command": "devboost.openScriptFile",
        "title": "Open Script File",
        "icon": "$(file-code)"
      },
      {
        "command": "devboost.configureSmartCmdAIModel",
        "title": "Configure AI Model for SmartCmd",
        "icon": "$(settings-gear)"
      },
      {
        "command": "devboost.bulkEditButtons",
        "title": "Bulk Edit Buttons",
        "icon": "$(edit)"
      },
      {
        "command": "devboost.configurePromptEnhancerAIModel",
        "title": "Configure AI Model for Prompt Enhancer",
        "icon": "$(settings-gear)"
      },
      {
        "command": "devboost.enableTrackingInCurrentSession",
        "title": "Enable Tracking Non-VScode Terminal Session",
        "icon": "$(debug-start)"
      },
      {
        "command": "devboost.disableTrackingInCurrentSession",
        "title": "Disable Tracking Non-VScode Terminal Session",
        "icon": "$(debug-stop)"
      },
      {
        "command": "devboost.manageApiKeys",
        "title": "Manage API Keys",
        "icon": "$(key)"
      },
      {
        "command": "devboost.createGroup",
        "title": "Create Group",
        "icon": "$(new-folder)"
      },
      {
        "command": "devboost.deleteGroup",
        "title": "Delete Group",
        "icon": "$(trash)"
      },
      {
        "command": "devboost.renameGroup",
        "title": "Rename Group",
        "icon": "$(edit)"
      },
      {
        "command": "devboost.addButtonToGroup",
        "title": "Add to Group",
        "icon": "$(add)"
      },
      {
        "command": "devboost.removeButtonFromGroup",
        "title": "Remove from Group",
        "icon": "$(remove)"
      },
      {
        "command": "devboost.editGroups",
        "title": "Edit Groups",
        "icon": "$(list-tree)"
      },
      {
        "command": "devboost.exportSmartCmds",
        "title": "Export Buttons",
        "icon": "$(export)"
      },
      {
        "command": "devboost.importSmartCmds",
        "title": "Import Buttons",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "devboost.showPromptEnhancer"
        }
      ],
      "view/title": [
        {
          "command": "devboost.smartCmdCreateButtons",
          "when": "view == devboost.smartCmdView",
          "group": "navigation@1"
        },
        {
          "command": "devboost.smartCmdCreateCustomButton",
          "when": "view == devboost.smartCmdView",
          "group": "navigation@2"
        },
        {
          "command": "devboost.bulkEditButtons",
          "when": "view == devboost.smartCmdView",
          "group": "navigation@3"
        },
        {
          "command": "devboost.editGroups",
          "when": "view == devboost.smartCmdView",
          "group": "navigation@4"
        },
        {
          "command": "devboost.refreshButtons",
          "when": "view == devboost.smartCmdView",
          "group": "navigation@5"
        },
        {
          "command": "devboost.configureSmartCmdAIModel",
          "when": "view == devboost.smartCmdView",
          "group": "z_tracking@1"
        },
        {
          "command": "devboost.manageApiKeys",
          "when": "view == devboost.smartCmdView",
          "group": "z_tracking@0"
        },
        {
          "command": "devboost.enableTrackingInCurrentSession",
          "when": "view == devboost.smartCmdView",
          "group": "z_tracking@2"
        },
        {
          "command": "devboost.disableTrackingInCurrentSession",
          "when": "view == devboost.smartCmdView",
          "group": "z_tracking@3"
        },
        {
          "command": "devboost.importSmartCmds",
          "when": "view == devboost.smartCmdView",
          "group": "z_tracking@4"
        },
        {
          "command": "devboost.exportSmartCmds",
          "when": "view == devboost.smartCmdView",
          "group": "z_tracking@5"
        },
        {
          "command": "devboost.configurePromptEnhancerAIModel",
          "when": "view == devboost.promptEnhancerView",
          "group": "z_tracking@1"
        },
        {
          "command": "devboost.manageApiKeys",
          "when": "view == devboost.promptEnhancerView",
          "group": "z_tracking@0"
        }
      ],
      "view/item/context": [
        {
          "command": "devboost.openButtonsFile",
          "when": "view == devboost.smartCmdView && viewItem == section",
          "group": "inline@1"
        },
        {
          "command": "devboost.editButton",
          "when": "view == devboost.smartCmdView && viewItem =~ /Button/",
          "group": "1_modify@1"
        },
        {
          "command": "devboost.addToGlobal",
          "when": "view == devboost.smartCmdView && viewItem =~ /^workspace.*Button/",
          "group": "1_modify@3"
        },
        {
          "command": "devboost.openScriptFile",
          "when": "view == devboost.smartCmdView && viewItem =~ /ScriptButton/",
          "group": "1_modify@2"
        },
        {
          "command": "devboost.addButtonToGroup",
          "when": "view == devboost.smartCmdView && viewItem =~ /Button/ && viewItem =~ /^(global|workspace)/",
          "group": "2_group@1"
        },
        {
          "command": "devboost.removeButtonFromGroup",
          "when": "view == devboost.smartCmdView && viewItem =~ /InGroupB$/",
          "group": "2_group@2"
        },
        {
          "command": "devboost.deleteButton",
          "when": "view == devboost.smartCmdView && viewItem =~ /Button$/",
          "group": "3_delete@1"
        },
        {
          "command": "devboost.createGroup",
          "when": "view == devboost.smartCmdView && viewItem == section",
          "group": "inline@3"
        },
        {
          "command": "devboost.renameGroup",
          "when": "view == devboost.smartCmdView && viewItem =~ /Group$/",
          "group": "1_group@1"
        },
        {
          "command": "devboost.deleteGroup",
          "when": "view == devboost.smartCmdView && viewItem =~ /Group$/",
          "group": "1_group@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.9.2",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.36.0",
    "typescript": "^5.9.3"
  }
}
